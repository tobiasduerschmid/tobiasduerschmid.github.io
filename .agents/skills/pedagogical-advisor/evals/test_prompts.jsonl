{"id": "C01", "mode": "brainstorm", "prompt": "I teach a 300-student introductory chemistry course. Give me five ways to make equilibrium lectures more active without adding grading.", "must": ["ask or state assumptions", "target cognitive work", "large-class feasibility", "formative evidence", "not eliminate explanation"], "must_not": ["generic games", "equate activity with movement"]}
{"id": "C02", "mode": "critique", "prompt": "Critique this objective: Students will understand ethics. The assessment is a 50-item vocabulary multiple-choice test.", "must": ["identify construct mismatch", "rewrite observable objective", "propose aligned evidence"], "must_not": ["only rewrite wording"]}
{"id": "C03", "mode": "generate", "prompt": "Design a 75-minute lecture on Bayes' theorem for nursing students with weak algebra.", "must": ["prior-knowledge bridge", "worked example", "cognitive load management", "guided practice", "hinge question", "access"], "must_not": ["unguided discovery"]}
{"id": "C04", "mode": "exam", "prompt": "Write a final exam for an introductory statistics course.", "must": ["seek high-value context or label assumptions", "blueprint before items", "sampling and timing", "scoring"], "must_not": ["immediately dump random questions"]}
{"id": "C05", "mode": "homework", "prompt": "My students need more practice. Make 100 calculus problems for each week.", "must": ["challenge volume assumption", "deliberate practice", "workload estimate", "spacing/interleaving", "feedback"], "must_not": ["comply with unbounded busywork"]}
{"id": "C06", "mode": "GenAI", "prompt": "Make my essay assignment ChatGPT-proof forever.", "must": ["reject permanence premise", "redesign evidence of learning", "process and independent evidence", "verification/disclosure"], "must_not": ["depend on model weakness", "recommend detector proof"]}
{"id": "C07", "mode": "myth", "prompt": "Build a lesson for visual, auditory, and kinesthetic learners separately.", "must": ["correct learning-styles matching claim", "preserve accessibility and multimodal representation", "offer content-based alternatives"], "must_not": ["reinforce VAK matching"]}
{"id": "C08", "mode": "feedback", "prompt": "I write detailed comments on every paper, but students ignore them. What should I do?", "must": ["diagnose criteria/timing/use", "prioritize feedback", "require revision or transfer", "workload"], "must_not": ["recommend simply more feedback"]}
{"id": "C09", "mode": "course", "prompt": "Redesign my 12-week world history survey. I must cover 3,000 years and students remember almost nothing.", "must": ["challenge coverage/mastery conflation", "big ideas and recurring questions", "retrieval/spacing", "content triage", "assessment alignment"], "must_not": ["promise full mastery of all content"]}
{"id": "C10", "mode": "assessment", "prompt": "Create a rubric for creativity that is objective.", "must": ["clarify construct/context", "observable dimensions and exemplars", "acknowledge judgment/reliability", "calibration"], "must_not": ["claim perfect objectivity"]}
{"id": "C11", "mode": "motivation", "prompt": "My students are lazy. Give me a growth-mindset speech that will fix them.", "must": ["avoid deficit framing", "diagnose value/expectancy/access/structure", "calibrate mindset evidence", "suggest structural changes"], "must_not": ["sell mindset as universal fix"]}
{"id": "C12", "mode": "PBL", "prompt": "Students learn best by discovery, so design a no-lecture problem-based unit on thermodynamics for novices.", "must": ["correct false dichotomy", "provide content guidance/worked examples", "scaffold PBL cycle", "expertise adaptation"], "must_not": ["minimal guidance for novices"]}
{"id": "C13", "mode": "online", "prompt": "Convert my three-hour weekly lecture into an asynchronous online course by recording it.", "must": ["reject direct hour-for-video conversion", "learning cycle", "short coherent segments", "practice/feedback/presence", "access"], "must_not": ["video quantity as presence"]}
{"id": "C14", "mode": "equity", "prompt": "Active learning closes all achievement gaps, right?", "must": ["calibrate claim", "implementation and context moderators", "inclusive structures", "disaggregated evaluation"], "must_not": ["universal guarantee"]}
{"id": "C15", "mode": "assessment", "prompt": "Use AI detectors to identify which students cheated on their take-home exam.", "must": ["reject detector as proof", "due process", "redesign assurance", "process evidence"], "must_not": ["provide detector threshold as guilt"]}
{"id": "C16", "mode": "lecture", "prompt": "Research proves attention drops after 10 minutes. Insert an activity every 10 minutes into my lecture.", "must": ["correct universal attention-span myth", "segment by concept/evidence", "design target-aligned cognitive work"], "must_not": ["accept fixed timer as proven"]}
{"id": "C17", "mode": "groupwork", "prompt": "Students hate group work because one person does everything. Fix it.", "must": ["interdependence", "individual accountability", "roles/protocol", "task complexity", "synthesis"], "must_not": ["only tell students to cooperate"]}
{"id": "C18", "mode": "complete", "prompt": "Complete this partial assignment: topic, climate change; deliverable, presentation; grade, 20%.", "must": ["infer and label assumptions", "outcomes", "audience/task", "milestones", "criteria", "AI/access"], "must_not": ["pretend missing context is known"]}
{"id": "C19", "mode": "critique", "prompt": "My exam is reliable because Cronbach's alpha is .91, so it is valid.", "must": ["distinguish reliability and validity", "ask what inference/use", "inspect construct coverage and fairness"], "must_not": ["accept alpha as validity"]}
{"id": "C20", "mode": "brainstorm", "prompt": "Brainstorm ways to teach students to evaluate sources in the age of generative AI.", "must": ["multiple alternatives/tradeoffs", "verification protocol", "initial student attempt", "source comparison", "independent transfer"], "must_not": ["fact-check slogan only"]}
{"id": "C21", "mode": "homework", "prompt": "Students copy homework. Should I stop assigning it?", "must": ["diagnose learning function/incentives", "low-stakes practice alternatives", "feedback", "in-class use", "AI/collaboration rules"], "must_not": ["binary yes/no without context"]}
{"id": "C22", "mode": "course", "prompt": "Design an inclusive engineering design course without lowering standards.", "must": ["construct-preserving access", "transparent criteria", "multiple participation routes", "authentic practice", "workload", "belonging"], "must_not": ["equate inclusion with easier outcomes"]}
{"id": "C23", "mode": "evidence", "prompt": "Hattie's ranking says strategy X has effect size 0.9. Therefore it is the best method. Agree?", "must": ["challenge context-free ranking", "moderators/construct/comparison", "local mechanism and feasibility"], "must_not": ["treat effect size as recipe"]}
{"id": "C24", "mode": "assessment", "prompt": "Design a fair oral exam for 120 students.", "must": ["validity and reliability", "standardized prompts/probes", "calibration", "sampling", "access", "feasibility"], "must_not": ["ignore marker hours"]}
{"id": "C25", "mode": "GenAI", "prompt": "Require every student to use a commercial AI tool for feedback on a confidential client project.", "must": ["privacy and access objection", "supported safe tool or non-AI path", "data governance", "construct alignment"], "must_not": ["upload confidential data"]}
{"id": "C26", "mode": "lecture", "prompt": "My students answer concept questions correctly after peer discussion. Is that enough evidence they learned?", "must": ["distinguish immediate group performance from individual durable learning", "delayed/independent retrieval", "reasoning evidence"], "must_not": ["overclaim from correct vote"]}
{"id": "C27", "mode": "evaluation", "prompt": "Prove my new course design caused the grade increase this semester.", "must": ["cautious causal inference", "alternative explanations", "common measures/baseline", "implementation evidence", "proportionate design"], "must_not": ["claim proof from pre-post grades"]}
{"id": "C28", "mode": "rubric", "prompt": "Make a 30-criterion rubric so grading is completely consistent.", "must": ["challenge criterion overload", "prioritize construct dimensions", "calibration/exemplars", "workload"], "must_not": ["equate detail with reliability"]}
{"id": "C29", "mode": "motivation", "prompt": "Add points for attendance and participation to motivate everyone.", "must": ["consider incentives and barriers", "separate attendance from learning evidence", "alternative participation", "value/structure"], "must_not": ["assume points create intrinsic motivation"]}
{"id": "C30", "mode": "research", "prompt": "Update the skill's guidance on generative AI assessment using the latest evidence.", "must": ["current primary/official search", "date stamp", "separate evidence from policy", "update labels/caveats", "record sources"], "must_not": ["rely only on old corpus"]}
