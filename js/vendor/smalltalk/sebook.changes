    instanceVariableNames: '' classVariableNames: '' poolDictionaries: '' category: 'SEBook-Runtime'!SEBookRefactoringClass methodsFor: 'method accessing'!!SEBookRefactoringClass methodsFor: 'method accessing'!methodFor: selector
    ^ model retainedMethod: (super methodFor: selector)! !!SEBookRefactoringClass methodsFor: 'method accessing'!bindingOf: name
    ^ model classVariableBinding: name in: self! !SEBookRefactoringMetaclass methodsFor: 'method accessing'!!SEBookRefactoringMetaclass methodsFor: 'method accessing'!methodFor: selector
    ^ model retainedMethod: (super methodFor: selector)! !!SEBookRefactoringMetaclass methodsFor: 'method accessing'!bindingOf: name
    ^ model classVariableBinding: name in: self! !SEBookRefactoringModel methodsFor: 'source model'!!SEBookRefactoringModel methodsFor: 'source model'!sourceReader: reader
    sourceReader := reader! !!SEBookRefactoringModel methodsFor: 'source model'!classVariableBinding: name in: modelClass
    "The pinned RB bindingOf: checks only the own pool and misses inherited-variable callers."
    modelClass realClass ifNotNil: [:real |
        real theNonMetaClass withAllSuperclasses do: [:class | | binding |
            binding := class classPool associationAt: name asSymbol ifAbsent: [nil].
            binding ifNotNil: [^ binding]]].
    ^ nil! !!SEBookRefactoringModel methodsFor: 'source model'!retainedMethod: method
    "New model methods already own their source; installed methods use the native ledger."
    (method notNil and: [method method notNil]) ifTrue: [
        method source: (sourceReader sourceFor: method selector in: method modelClass realClass)].
    ^ method! !!SEBookRefactoringModel methodsFor: 'source model'!createNewClassFor: behavior
    | name |
    name := behavior theNonMetaClass name.
    ^ changedClasses at: name put: (Array
        with: ((SEBookRefactoringClass existingNamed: name) model: self; yourself)
        with: ((SEBookRefactoringMetaclass existingNamed: name) model: self; yourself))! !RBAddMethodChange subclass: #SEBookAddMethodChange	instanceVariableNames: 'sourceReader'	classVariableNames: ''	poolDictionaries: ''	category: 'SEBook-Runtime'!RBAddMethodChange subclass: #SEBookAddMethodChange
