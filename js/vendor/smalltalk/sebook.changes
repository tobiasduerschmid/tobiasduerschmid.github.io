    instanceVariableNames: 'sourceReader' classVariableNames: '' poolDictionaries: '' category: 'SEBook-Runtime'!SEBookAddMethodChange methodsFor: 'retained inverse'!!SEBookAddMethodChange methodsFor: 'retained inverse'!sourceReader: reader
    sourceReader := reader! !!SEBookAddMethodChange methodsFor: 'retained inverse'!identityFrom: change
    className := change changeClassName. isMeta := change isMeta! !!SEBookAddMethodChange methodsFor: 'retained inverse'!asUndoOperation
    ^ SEBookRefactorings inverseFor: self reader: sourceReader! !SEBookRemoveMethodChange methodsFor: 'retained inverse'!!SEBookRemoveMethodChange methodsFor: 'retained inverse'!sourceReader: reader
    sourceReader := reader! !!SEBookRemoveMethodChange methodsFor: 'retained inverse'!identityFrom: change
    className := change changeClassName. isMeta := change isMeta! !!SEBookRemoveMethodChange methodsFor: 'retained inverse'!asUndoOperation
    ^ SEBookRefactorings inverseFor: self reader: sourceReader! !Object subclass: #SEBookRefactorings	instanceVariableNames: 'sourceReader previews nextToken generation'	classVariableNames: ''	poolDictionaries: ''	category: 'SEBook-Runtime'!Object subclass: #SEBookRefactorings
    instanceVariableNames: 'sourceReader previews nextToken generation'
    classVariableNames: '' poolDictionaries: '' category: 'SEBook-Runtime'!SEBookRefactorings class methodsFor: 'native method changes'!!SEBookRefactorings class methodsFor: 'native method changes'!definitionForModelClass: class
    class isMeta ifFalse: [^ class definitionString].
    ^ class printString, ' instanceVariableNames: ', (String streamContents: [:stream |
        class instanceVariableNames do: [:name | stream nextPutAll: name; space]]) storeString! !!SEBookRefactorings class methodsFor: 'native method changes'!inverseFor: change reader: reader
    | class selector |
    class := change changeClass. selector := change selector.
    ^ ((class includesSelector: selector)
        ifTrue: [SEBookAddMethodChange compile: (reader sourceFor: selector in: class)
            in: class classified: (class organization categoryOfElement: selector)]
