    <primitive: 'primitiveStructuralSeal' module: 'SEBookPlugin'>
    self error: 'STRUCTURAL_SEAL_UNAVAILABLE'! !!SEBookStructuralGuard class methodsFor: 'image preparation'!literalRecordsFor: method cached: cache
