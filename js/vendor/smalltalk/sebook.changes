ring-Changes' ];			package: 'Refactoring-Tests-Critics' with: [ spec requires: 'Refactoring-Critics' ];					package: 'Refactoring-Spelling' with: [ 				spec requires: 'Refactoring-Critics'.				spec postLoadDoIt: #postLoadRBSpelling ];			package: 'Refactoring-Tests-Spelling' with: [ spec requires: 'Refactoring-Tests-Critics'. ].			spec			group: 'default' with: #('Core' );			group: 'Core' with: #( 'AST-Core' 'AST-Semantic' 'Refactoring-Environment'  'Refactoring-Changes' 'Refactoring-Core'  'Refactoring-Critics' 'Refactoring-Spelling'  );			group: 'Tests' with: #( 'AST-Tests-Core'  'AST-Tests-Semantic' 'Refactoring-Tests-Environment'  'Refactoring-Tests-Changes'  'Refactoring-Tests-Core' 'Refactoring-Tests-Critics' 'Refactoring-Tests-Spelling' );			group: 'Core Tests' with: #('Core' 'Tests' );						yourself.	].! !!ConfigurationOfRefactoringBrowser methodsFor: 'symbolic versions' stamp: 'mt 6/30/2022 09:57'!development: spec    <symbolicVersion: #development>    spec for: #squeakCommon version: '2.0-baseline'.! !!ConfigurationOfRefactoringBrowser methodsFor: 'baselines' stamp: 'dkh 07/20/2011 15:41'!postLoadRBSpelling	"We want to initialize and download the dictionary file so that tests can be run without internet."	Smalltalk at: #RBInternalSpellChecker ifPresent: [:cl | cl  new ].! !!ConfigurationOfRefactoringBrowser methodsFor: 'accessing' stamp: 'MarianoMartinezPeck 12/18/2009 16:21'!project	^ project ifNil: [ | constructor |		"Bootstrap Metacello if it is not already loaded"		self class ensureMetacello.		"Construct Metacello project"		constructor := (Smalltalk at: #MetacelloVersionConstructor) on: self.		project := constructor project.		project loadType: #linear.		project ]! !!ConfigurationOfRefactoringBrowser methodsFor: 'symbolic versions' stamp: 'mt 6/30/2022 09:56'!stable: spec 	<symbolicVersion: #stable>		spec for: #'pharo1.0.x' version: '1.2.1'. 	spec for: #'pharo1.1.x' version: '1.5'. 	spec for: #'pharo1.2.x' version: '1.7'.	spec for: #'pharo1.3.x' version: '1.7'. 	spec for: #'pharo1.4.x' version: '2.0.1'.  	spec for: #'pharo2.0.x' version: '2.0.1'.		spec for: #'squeak5.0.x' version: '2.0.2'.	spec for: #'squeak5.1.x' version: '2.0.2'.	spec for: #'squeak5.2.x' version: '2.0.2'.	spec for: #'squeak5.3.x' version: '3.0'.	spec for: #'squeak6.x' version: '3.1'.	! !!ConfigurationOfRefactoringBrowser methodsFor: 'versions' stamp: 'MarianoMartinezPeck 1/14/2010 23:36'!version10: spec	<version: '1.0' imports: #('1.0-baseline')>	spec for: #common do: [		spec blessing: #release.		spec author: 'MarianoMartinezPeck'.		spec description: 'First release 1.0 of this project '.	].	spec for: #pharo do: [			spec 			package: 'AST-Core' with: 'AST-Core-lr.49';			package: 'AST-Tests' with: 'AST-Tests-lr.5';			package: 'Refactoring-Core' with: 'Refactoring-Core-lr.94';			package: 'Refactoring-Tests' with: 'Refactoring-Tests-lr.30';			package: 'Refactoring-Spelling' with: 'Refactoring-Spelling-lr.13'.	].	spec for: #squeak do: [			spec author: 'DaleHenrichs'.		spec description: 'Squeak support based on Squeak3.10.2-Trunk-090912 and OmniBrowser-2.0.3.sar'.		spec 			package: 'AST-Core' with: 'AST-Gwenael_Casaccio.215';			package: 'Refactoring-Core' with: 'Refactoring-Core-lr.57';			package: 'Refactoring-Spelling' with: 'Refactoring-Spelling-lr.6'.	].			! !!ConfigurationOfRefactoringBrowser methodsFor: 'versions' stamp: 'MarianoMartinezPeck 1/22/2010 10:09'!version11: spec	<version: '1.1' imports: #('1.1-baseline')>	spec for: #common do: [		spec blessing: #development.		spec author: 'MarianoMartinezPeck'.		spec description: '- Added fixes and tests for Refactoring-Spelling		- new versions '.	].	spec for: #pharo do: [			spec 			package: 'AST-Core' with: 'AST-Core-lr.49';			package: 'AST-Tests' with: 'AST-Tests-lr.5';			package: 'Refactoring-Core' with: 'Refactoring-Core-lr.101';			package: 'Refactoring-Tests' with: 'Refactoring-Tests-lr.31';			package