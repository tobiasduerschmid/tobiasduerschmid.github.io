        at: 'reason' put: ((undo or: [redo]) ifTrue: [nil] ifFalse: ['No refactoring history. Ordinary accepted source or file edits and session restarts clear history.']); yourself! !!SEBookRefactorings methodsFor: 'lifecycle'!fail: message
