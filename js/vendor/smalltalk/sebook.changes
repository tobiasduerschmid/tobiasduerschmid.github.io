    super initialize. previews := Dictionary new. nextToken := 0! !!SEBookRefactorings methodsFor: 'lifecycle'!sourceReader: reader generation: identity
    sourceReader := reader. self generation: identity.
    self ordinarySourceAccepted! !!SEBookRefactorings methodsFor: 'lifecycle'!ordinarySourceAccepted
    "The accepted-program boundary is stricter than upstream notification filtering."
    RBRefactoryChangeManager instance clearUndoRedoList! !!SEBookRefactorings methodsFor: 'lifecycle'!generation: identity
    generation := identity. previews removeAll! !!SEBookRefactorings methodsFor: 'lifecycle'!history
    | manager undo redo |
