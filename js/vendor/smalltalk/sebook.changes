    instanceVariableNames: 'pageLimit sourceReader'
    classVariableNames: '' poolDictionaries: '' category: 'SEBook-Runtime'!SEBookBrowser methodsFor: 'configuration'!!SEBookBrowser methodsFor: 'configuration'!pageLimit: count
    pageLimit := count! !!SEBookBrowser methodsFor: 'configuration'!sourceReader: reader
    sourceReader := reader! !SEBookBrowser methodsFor: 'queries'!!SEBookBrowser methodsFor: 'queries'!browse: query revision: revision
    | kind selector items source result |
    kind := query at: 'kind'.
    selector := kind = 'variableReferences' ifTrue: [#queryVariableReferences:] ifFalse: [('query', kind capitalized, ':') asSymbol].
    (self respondsTo: selector) ifFalse: [self error: 'PRECONDITION_FAILED'].
    kind = 'source'
