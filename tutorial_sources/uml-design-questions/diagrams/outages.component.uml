OPC.opc_orders @pos(400, 560)
OPC.opc_card @pos(600, 560)
OPC.opc_box_callback @pos(622, 633)
OPC.opc_box_booking @pos(622, 590)
OPC.opc_exp_booking @pos(622, 676)
OPC.opc_exp_callback @pos(622, 719)
Bank.bank_card_opc @pos(800, 270)
BoxOffice.box_callback @pos(1340, 222)
BoxOffice.box_booking @pos(1130, 222)
ExperienceProvider.exp_booking @pos(1500, 142)
ExperienceProvider.exp_callback @pos(1680, 142)
OPC.opc_lodging_booking @pos(622, 762)
OPC.opc_lodging_callback @pos(622, 805)
OPC.opc_shuttle_booking @pos(622, 857)
OPC.opc_shuttle_callback @pos(622, 900)
LodgingProvider.lodging_booking @pos(1760, 762)
LodgingProvider.lodging_callback @pos(1760, 805)
ShuttleProvider.shuttle_booking @pos(2067, 857)
ShuttleProvider.shuttle_callback @pos(2067, 900)
OPC.opc_sql @pos(330, 800)
OrderDB.order_sql @pos(143, 800)
OPC.opc_publish @pos(440, 912)
MessageBroker.broker_publish @pos(440, 1070)
Notifications.notifications_smtp @pos(567, 1375)
MailRelay.mail_smtp @pos(1100, 1375)
note:94 @pos(0, 310)
@endlayout
@enduml
